---
import Base from '../layouts/Base.astro';
import '../styles/home.css';

const links = [
  { href: 'https://github.com/W-Whoam', label: 'GitHub', external: true },
  { href: 'https://ulus.me', label: 'Ulus', external: true },
  { href: '/are-you-a-human-pale-guy/', label: 'Yalnız mısın?', external: false },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'who.ulus.me',
  url: 'https://who.ulus.me/',
  inLanguage: 'tr',
};
---
<Base title="who.ulus.me" description="Whoam'ın sitesi. Yakında." jsonLd={jsonLd}>
  <main class="home">
    <h1>Yakında...</h1>
    <a href="https://github.com/W-Whoam/website" target="_blank" rel="noopener noreferrer">W-Whoam / website</a>
    <nav>
      {links.map((l) =>
        l.external
          ? <a href={l.href} target="_blank" rel="me noopener noreferrer">{l.label}</a>
          : <a href={l.href}>{l.label}</a>
      )}
    </nav>
  </main>
</Base>
