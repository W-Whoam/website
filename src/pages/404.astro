---
import Base from '../layouts/Base.astro';
---
<Base title="404 · who.ulus.me" description="Bu adreste bir sayfa yok." noindex>
  <main class="nf">
    <h1>404</h1>
    <p>Bu adreste bir sayfa yok. <a href="/">who.ulus.me</a></p>
  </main>
</Base>

<style is:global>
  html, body { margin: 0; min-height: 100%; background: #000; color: #fff; }
  body { font: 400 1rem/1.5 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .nf { min-height: 100svh; box-sizing: border-box; padding: 24px; display: grid; place-content: center; text-align: center; gap: 10px; }
  .nf h1 { margin: 0; font-size: clamp(2.4rem, 8vw, 4.5rem); font-weight: 700; }
  .nf p { margin: 0; color: #9a9a9a; }
  .nf a { color: #fff; text-underline-offset: 4px; }
</style>
