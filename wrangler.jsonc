// Cloudflare Workers: static assets only. No Worker script, no bindings,
// free plan. `wrangler deploy` runs the build itself, then uploads dist/.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard, or Git builds fail.
	"name": "whoam-website",
	"compatibility_date": "2026-10-01",
	// Runs before `wrangler deploy` and `wrangler dev`, so a deploy works even
	// when the dashboard has no build command set.
	"build": {
		"command": "bun run build"
	},
	"assets": {
		"directory": "./dist",
		// /are-you-a-human-pale-guy -> /are-you-a-human-pale-guy/
		"html_handling": "auto-trailing-slash",
		// Unknown paths get dist/404.html with a 404 status.
		"not_found_handling": "404-page"
	}
}
